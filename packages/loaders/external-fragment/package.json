{
  "name": "@graphql-tools/external-fragment-loader",
  "version": "1.0.6",
  "type": "module",
  "description": "A GraphQL loader that resolves cross-package fragment dependencies from external packages",
  "repository": {
    "type": "git",
    "url": "ardatan/graphql-tools",
    "directory": "packages/loaders/external-fragment"
  },
  "author": "Igor Kusakov <igor@kusakov.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./*": {
      "require": {
        "types": "./dist/typings/*.d.cts",
        "default": "./dist/cjs/*.js"
      },
      "import": {
        "types": "./dist/typings/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "default": {
        "types": "./dist/typings/*.d.ts",
        "default": "./dist/esm/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "dependencies": {
    "@graphql-tools/graphql-tag-pluck": "9.0.6",
    "@graphql-tools/load-files": "^8.0.5",
    "@graphql-tools/utils": "^13.1.2",
    "memoizee": "^0.4.17",
    "tslib": "^2.4.0",
    "unixify": "^1.0.0"
  },
  "devDependencies": {
    "@graphql-tools/load": "9.0.5",
    "@types/memoizee": "^0.4.11"
  },
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "sideEffects": false,
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
