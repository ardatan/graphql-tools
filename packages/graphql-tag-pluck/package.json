{
  "name": "@graphql-tools/graphql-tag-pluck",
  "version": "9.0.8",
  "type": "module",
  "description": "Pluck graphql-tag template literals",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardatan/graphql-tools.git",
    "directory": "packages/graphql-tag-pluck"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/typings/index.d.cts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "default": {
        "types": "./dist/typings/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./*": {
      "require": {
        "types": "./dist/typings/*.d.cts",
        "default": "./dist/cjs/*.js"
      },
      "import": {
        "types": "./dist/typings/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "default": {
        "types": "./dist/typings/*.d.ts",
        "default": "./dist/esm/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typings": "dist/typings/index.d.ts",
  "peerDependencies": {
    "graphql": "^16.0.0 || ^17.0.0"
  },
  "dependencies": {
    "@babel/core": "^8.0.7",
    "@babel/parser": "^8.0.7",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.6",
    "@graphql-tools/utils": "^13.2.0",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@astrojs/compiler": "4.0.0",
    "@types/babel__traverse": "7.28.0",
    "@vue/compiler-sfc": "3.5.44",
    "astrojs-compiler-sync": "1.1.1",
    "content-tag": "4.2.1",
    "svelte": "5.57.3",
    "svelte2tsx": "0.7.62"
  },
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "sideEffects": false,
  "buildOptions": {
    "external": [
      "@vue/compiler-sfc",
      "svelte2tsx",
      "@astrojs/compiler"
    ]
  },
  "typescript": {
    "definition": "dist/typings/index.d.ts"
  }
}
